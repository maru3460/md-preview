---
import DocLayout from '../../layouts/DocLayout.astro';

// 並びと文言は src/assets/js/keymap.js の BINDS に合わせる（? で出る一覧と同じ順）。
const groups = [
  ['読み進める', [
    ['j / k', '1 行スクロール 下 / 上'],
    ['d / u', '半ページ 下 / 上'],
    ['Space', '1 ページ送り（⇧Space で戻る）'],
    ['g / G', '冒頭 / 末尾へ'],
  ]],
  ['探す・飛ぶ', [
    ['/', '検索を開く（閉じるのは Esc か ⌘F）'],
    ['⌘F', '検索の開閉'],
    ['⌘T', 'アウトライン（見出しナビ）の開閉'],
    ['⌘P', 'ファイル検索（あいまい検索。未入力なら git 変更ファイルが先頭）'],
  ]],
  ['表示を切り替える', [
    ['⌘D', 'Git 差分表示の切り替え'],
    ['⌘R', 'Raw（生ソース）表示の切り替え'],
  ]],
  ['コメント', [
    ['c', 'コメントモードの開始 / 終了'],
  ]],
  ['ファイル移動・タブ', [
    ['] / [', '次 / 前のファイルへ'],
    ['Tab', '本文 ⇄ ファイルツリーのフォーカス切り替え'],
    ['⇧Tab', '次のタブへ（端まで行ったら先頭へ）'],
    ['⌘1 … ⌘9', 'n 番目のタブへ（⌘9 は最後）'],
  ]],
  ['ファイルツリー', [
    ['⌘B', 'ファイルツリー（左サイドバー）の開閉'],
    ['j / k', 'ツリー内: 上下に移動'],
    ['g / G', 'ツリー内: 先頭 / 末尾へ'],
    ['Enter / l', 'ツリー内: 開く・展開する'],
    ['h', 'ツリー内: 畳む・親へ'],
  ]],
  ['ウィンドウ・ヘルプ', [
    ['⌘A', '本文だけを全選択'],
    ['⌃⌘F', 'フルスクリーンの切り替え'],
    ['⌘W', 'タブを閉じる（最後の 1 枚ならウィンドウ）'],
    ['⌘⇧W', 'ウィンドウを閉じる'],
    ['⌘Q', '終了'],
    ['?', 'キーバインドの一覧を出す'],
    ['Esc', '検索 / メニュー / ヘルプ / コメントを閉じる'],
  ]],
];

// comment.astro の表と同じ内容。片方だけ直さないこと。
const commentKeys = [
  ['j / k', 'ユニット間を移動（↑ / ↓ でも）'],
  ['⇧J / ⇧K', '複数行をまとめて選ぶ'],
  ['Enter', 'コメント入力を開く'],
  ['⌘Enter', '保存'],
  ['Esc', '取り消し'],
  ['n / p', '次 / 前のコメントへ'],
  ['e', '編集'],
  ['x / Delete', '削除'],
  ['⇧X', '全消去'],
  ['y', '全部コピー'],
];
---
<DocLayout slug="keys" title="キーバインド" description="md-preview のキーボードショートカット一覧。">
  <p>
    ウィンドウの中で <kbd>?</kbd> を押すと、同じ一覧がその場で出ます。
    標準の編集メニュー（Undo / Redo / Cut / Copy / Paste / Select All）も使えます。
  </p>

  {groups.map(([name, rows]) => (
    <>
      <h2>{name}</h2>
      <div class="keys">
        {rows.map(([k, d]) => (
          <div class="keyrow"><kbd>{k}</kbd><span class="kdesc">{d}</span></div>
        ))}
      </div>
    </>
  ))}

  <h2>コメントモード中</h2>
  <div class="keys">
    {commentKeys.map(([k, d]) => (
      <div class="keyrow"><kbd>{k}</kbd><span class="kdesc">{d}</span></div>
    ))}
  </div>
</DocLayout>
