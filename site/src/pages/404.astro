---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="ページが見つかりません — md-preview" description="そのページはありません。">
  <section class="section">
    <div class="section-inner" style="max-width:640px;text-align:center">
      <h1 style="font-size:28px;margin-bottom:12px">ページが見つかりません</h1>
      <p style="color:var(--fg-dim);margin-bottom:24px">URL が変わったか、はじめから無いページです。</p>
      <p><a href={`${base}/`}>Home へ</a> · <a href={`${base}/doc/`}>Doc へ</a></p>
    </div>
  </section>
</Base>
